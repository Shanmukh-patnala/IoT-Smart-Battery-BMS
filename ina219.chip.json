{
  "name": "INA219-Custom-Battery-Sensor",
  "author": "Shanmukh Patnala",
  "pins": [
    "VCC",
    "GND",
    "SDA",
    "SCL",
    "VIN+",
    "VIN-"
  ],
  "controls": [
    {
      "id": "batteryVoltage",
      "label": "Battery Voltage (V)",
      "type": "range",
      "min": 3.0,
      "max": 4.2,
      "step": 0.001,
      "value": 4.2
    },
    {
      "id": "loadCurrent",
      "label": "Load Current (mA)",
      "type": "range",
      "min": 50,
      "max": 1000,
      "step": 10,
      "value": 150
    }
  ]
}
